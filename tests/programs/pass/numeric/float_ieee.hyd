fn main() {
    println(1.5 + 2.0)
    println(5.0 - 2.5)
    println(1.5 * 2.0)
    println(5.0 / 2.0)
    println(5.5 % 2.0)
    println(1.5 < 2.0)
    println(2.0 == 2.0)
    println(-1.5)
    let positive_infinity = 1.0 / 0.0
    let negative_infinity = -1.0 / 0.0
    let nan = 0.0 / 0.0
    println(positive_infinity)
    println(negative_infinity)
    println(nan)
    println(nan == nan)
    println(nan != nan)
}
